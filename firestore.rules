rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders: only you (the admin) can read/write any order
    // Customers can create a new order but not read others
    match /orders/{orderId} {
      allow create: if true;          // anyone can submit a cart
      allow read, update, delete: if request.auth != null;  // only logged-in admin
    }
  }
}